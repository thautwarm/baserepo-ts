{
  "name": "typescript-monorepo-template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=24.6.0"
  },
  "template": {
    "scope": "@template"
  },
  "scripts": {
    "start": "node apps/cli/src/main.ts",
    "check": "node make.ts check",
    "interface:check": "node make.ts interface:check",
    "lint": "node make.ts lint",
    "lint:fix": "biome check --write .",
    "fmt": "biome format --write .",
    "provision": "node scripts/provision.ts",
    "schema": "node make.ts schema",
    "test": "node make.ts tests",
    "verify": "node make.ts verify"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@nomake/core": "0.2.0",
    "@template/tsconfig": "workspace:*",
    "@types/node": "24.19.2",
    "ts-to-zod": "5.1.0",
    "typescript": "7.0.2"
  }
}
